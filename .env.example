# Ignitic — Docker Compose configuration
#
#   cp .env.example .env
#   docker compose up -d
#
# The defaults below are for LOCAL DEVELOPMENT ONLY. Replace every secret
# before exposing an instance to a network.

# ─── Required: LLM provider ───────────────────────────────────────────────
# Agents call models through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Shared secrets ───────────────────────────────────────────────────────
# Shared by backend, ai-engine and mcp.   openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Backend credential encryption: base64 of 32 random bytes.   openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1lbmNyeXB0aW9uLWtleSE=
# AI engine Fernet key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASS_ENCRYPTION_FERNET_KEY=ZGV2LW9ubHktZmVybmV0LWtleS1jaGFuZ2UtbWUhISE=
# NextAuth session secret.   openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-nextauth-secret-change-me

# ─── Infrastructure credentials ───────────────────────────────────────────
POSTGRES_USER=ignitic
POSTGRES_PASSWORD=ignitic
POSTGRES_DB=ignitic
RABBITMQ_USER=ignitic
RABBITMQ_PASSWORD=ignitic
NEO4J_PASSWORD=ignitic-neo4j

# ─── Public URLs (as seen from your browser) ──────────────────────────────
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# ─── Host ports ───────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_ENGINE_PORT=8010
MCP_PORT=8011

# ─── Optional integrations ────────────────────────────────────────────────
APIFY_TOKEN=
BREVO_API_KEY=
SENDER_EMAIL=noreply@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=
SHOPIFY_OAUTH_STATE_SECRET=
# Only used with `docker compose --profile n8n up`
N8N_API_KEY=
