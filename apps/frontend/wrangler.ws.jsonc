{
  "name": "frontend-ws",
  "main": "src/functions/ws.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "frontend-ws.app.igniticai.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BACKEND_URL": "wss://intermediate-guide-chairs-show.trycloudflare.com/v1/agents/ws"
  }
}
