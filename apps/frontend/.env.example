# Public URL of the backend API, as seen by the browser (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: backend URL for server-side calls when it differs from the public one
# (e.g. http://backend:8080 inside Docker Compose)
# API_INTERNAL_URL=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical site URL, no trailing slash
NEXTAUTH_URL=http://localhost:3000
# Behind a reverse proxy, derive the origin from x-forwarded-* headers instead
# AUTH_TRUST_HOST=true

# File uploads (Cloudinary) — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
