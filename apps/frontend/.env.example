NEXT_PUBLIC_API_URL=http://localhost:8080

# NextAuth (required in production). On AWS Amplify, Console env vars are not available to SSR/Lambda unless
# they are written to .env.production before `next build` — see amplify.yml in this repo.
# NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical site URL (no trailing slash). On Amplify, NODE_ENV=production and VERCEL is unset—set this or use AUTH_TRUST_HOST below.
NEXTAUTH_URL=http://localhost:3000
# Optional on Amplify: lets NextAuth build the origin from x-forwarded-host / x-forwarded-proto instead of only NEXTAUTH_URL.
# AUTH_TRUST_HOST=true
