# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Database Configuration
DB_NAME=ai_engine_db

# Server Configuration
PORT=8001
HOST=0.0.0.0

# JWT Configuration (must match your backend)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# n8n Configuration
N8N_API_KEY=your-n8n-api-key
N8N_SERVER_URL=http://localhost:5678/api/v1

# Security Configuration
PASS_ENCRYPTION_FERNET_KEY=your-fernet-key-32-bytes-long-change-this

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Environment
ENVIRONMENT=development
DEBUG=true

# Neo4j Configuration (required for Graphiti long-term knowledge-graph memory)
# Install Neo4j Desktop: https://neo4j.com/download/
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE defaults to 'neo4j'. Override for Neo4j Aura or named databases.
NEO4J_DATABASE=neo4j

# Graphiti model overrides (all served via OpenRouter – reuses OPENROUTER_API_KEY)
# Leave unset to use the defaults shown below.
GRAPHITI_LLM_MODEL=openai/gpt-4o-mini
GRAPHITI_SMALL_MODEL=openai/gpt-4o-mini
GRAPHITI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Summarization model — used for compressing chat history (should be fast & cheap)
# Defaults to openai/gpt-4o-mini if not set.
SUMMARIZATION_MODEL=openai/gpt-4o-mini

# Vision capability flag — set to true only when using a vision-capable model
# (e.g. openai/gpt-4o, google/gemini-2.0-flash, anthropic/claude-3-5-sonnet).
# When false (default), image tool results are replaced with a text notice
# instead of injecting base64 image_url blocks, preventing 404 errors from
# models that do not support image input.
VISION_CAPABLE=false