                "type": "List[str]",
                "description": "List of email addresses that were accepted by the SMTP server."
            },
            "rejected": {
                "type": "List[str]",
                "description": "List of email addresses that were rejected by the SMTP server."
            },
            "response": {
                "type": "str",
                "description": "SMTP server response message."
            }
