[
    {
        "ignitic_identifier": "workflows.n8n.marketer.email_sender_smtp",
        "name": "Email Sending tool using SMTP",
        "description": "Send emails using SMTP protocol",
        "inputs": {
            "subject": {
                "type": "str",
                "required": false,
                "description": "The subject line of the email."
            },
