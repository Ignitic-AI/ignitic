                    ],
                    "webhookId": "012ca109-03f0-445c-826c-45b4e85d21fe",
                    "typeVersion": 2.1,
                    "credentials": {
                        "gmailOAuth2": {
                            "id": "vyHW7dS3CrK13Zbo",
                            "name": "Gmail account - Ignitic AI"
                        }
                    }
