        "ignitic_identifier": "workflows.n8n.marketer.raw_testimonial_enhancer",
        "name": "Raw Testimonial Enhancer",
        "description": "This workflow takes a google sheet containing raw testimonials or reviews of customers and enhances them using Gemini. The enhanced testimonials are then saved back to the same sheet. The input sheet must contain a column named 'Raw Testimonial' which contains the unprocessed testimonials. The workflow processes each testimonial, enhances it using Gemini, and saves the enhanced version in a new column named 'Enhanced Testimonial'. If the input sheet does not contain the required column, the workflow stops and returns an error message.",
        "inputs": {
            "raw_testimonials_google_sheet_id": {
                "type": "str",
                "required": true,
                "description": "The ID of the Google Sheet containing raw testimonials."
            },
            "raw_testimonials_google_subsheet_name": {
                "type": "str",
                "required": true,
                "description": "The name of the subsheet within the Google Sheet. e.g. Sheet1"
            }
        },
        "outputs": {
            "testimonials_processed": {
                "type": "int",
                "description": "Number of testimonials that were processed and enhanced."
            }
        },
