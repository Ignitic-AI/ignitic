    {
        "ignitic_identifier": "workflows.n8n.marketer.personalized_email_campaign",
        "name": "Personalized Email Campaign",
        "description": "This workflow takes info about the offer/product(s) you want to market and a list of customer details including their names and email addresses. It uses an AI language model to generate personalized marketing emails for each customer based on the provided offer details. The generated emails are then sent to the respective customers using an Gmail email sender. This workflow helps in creating and sending tailored email campaigns to enhance customer engagement and conversion rates.",
        "inputs": {
            "offer_info": {
                "type": "str",
                "required": true,
                "description": "Details about the offer or product(s) to be marketed."
            },
            "clients_google_sheet_id": {
                "type": "str",
                "required": true,
                "description": "the ID of the Google Sheet containing details of all the clients to whom this product is to be marketed."
            },
            "clients_google_subsheet_name": {
                "type": "str",
                "required": true,
                "description": "The name of the subsheet within the Google Sheet. e.g. Sheet1"
            }
        },
        "outputs": {
            "emails_processed_count": {
                "type": "int",
                "description": "Number of personalized emails that were generated"
            },
            "emails_sent_count": {
                "type": "int",
                "description": "Number of personalized emails that were successfully sent"
            },
            "emails_sent": {
                "type": "List[Dict[str, Any]]",
                "description": "Details of the emails that were successfully sent"
            },
            "emails_failed_count": {
                "type": "int",
                "description": "Number of personalized emails that failed to send"
            },
            "emails_failed_addresses": {
                "type": "List[str]",
                "description": "Email addresses that failed to receive the personalized email"
            }
        },
        "n8n_json": {
            "name": "Personalized Email Marketing",
            "nodes": [
                {
                    "parameters": {
                        "promptType": "define",
                        "text": "=You are an expert sales copywriter. Based on the provided offer data and customer information generate a personalizd, persuasive and emotionally engaging promotional message Email that motivates immediate customer action.\n\n🎯 **Objective:**\nEncourage purchases by emphasizing value, benefits, urgency, and exclusivity with a detailed, impactful message.\n\n📌 **Format Guidelines:**\n- Keep under 150 words.\n- Use short, readable lines for WhatsApp/email.\n- Include 3–5 well-placed emojis for visual appeal.\n- Write in a warm, enthusiastic, benefit-driven tone.\n- Use bold hooks, clear product benefits, urgency, and rewards.\n- Structure with multiple unordered lists (`<ul>`) for impact and readability.\n\n📋 **Offer Data:**\n{{ $('Webhook').item.json.body.offer_info }}\n\n**Customer Data:**\n{{ JSON.stringify($('Fetch Clients Data').item.json) }}\n\n📢 **Message Structure:**\n1. Start with a catchy, energetic title using 1–2 emojis.\n2. Hook with emotional language (e.g., “refresh your style,” “upgrade your look”).\n3. State this deal as a steal.\n4. List products included in a `<ul>` with specific benefits (e.g., fabric, fit, usage), if any.\n5. Highlight bundle value in a second `<ul>` (e.g., quality, versatility, savings), if any.\n6. Present bonus as an exclusive gift with an emoji (e.g., 🎁), if any.\n7. Emphasize urgency with limited time offer and “limited stock” using ⏳, if relevant.\n8. End with a motivational line to create FOMO.\n\n\n✅ **Notes:**\n- Make the message personal, warm, and engaging.\n- Avoid robotic or templated language.\n- Use `<ul>` for product details and benefits to enhance readability.\n- Ensure clear formatting with emojis, short lines, and emotional appeal.\n- Do not include notes or explanations in the output.",
                        "hasOutputParser": true,
                        "options": {}
                    },
                    "id": "e7f44537-37ee-4ce8-8d9a-25e1e512bcbe",
                    "name": "Generate Marketing Content with AI",
                    "type": "@n8n/n8n-nodes-langchain.agent",
                    "position": [
                        1200,
                        624
                    ],
                    "typeVersion": 2
                },
                {
                    "parameters": {
                        "sendTo": "={{ $json.output.client_email }}",
                        "subject": "={{ $json.output.subject }}",
                        "message": "={{ $json.output.body }}",
                        "options": {
                            "appendAttribution": false
                        }
                    },
                    "id": "bf3e161a-be8b-45b5-859d-b5404fe0264b",
                    "name": " Send Marketing Email to Client",
                    "type": "n8n-nodes-base.gmail",
                    "position": [
                        1600,
