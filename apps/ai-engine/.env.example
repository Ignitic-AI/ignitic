# ─── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8010
ENVIRONMENT=development
DEBUG=true

# ─── Service URLs ─────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8080
MCP_SERVER_URL=http://localhost:8011

# ─── MongoDB ──────────────────────────────────────────────────────────────
# Vector search requires MongoDB Atlas or the mongodb-atlas-local image.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
DB_NAME=ignitic
MONGO_DB_NAME=ignitic

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Security ─────────────────────────────────────────────────────────────
# Must be identical across backend, ai-engine and mcp.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASS_ENCRYPTION_FERNET_KEY=

# ─── LLM (OpenRouter) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=
SUMMARIZATION_MODEL=openai/gpt-4o-mini
INTENT_CLASSIFIER_MODEL=
# Set true only when the configured model accepts image input.
VISION_CAPABLE=false

# ─── Long-term memory (Neo4j + Graphiti) ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j
GRAPHITI_LLM_MODEL=openai/gpt-4o-mini
GRAPHITI_SMALL_MODEL=openai/gpt-4o-mini
GRAPHITI_EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Integrations — optional ──────────────────────────────────────────────
APIFY_TOKEN=
N8N_API_KEY=
N8N_SERVER_URL=http://localhost:5678/api/v1
