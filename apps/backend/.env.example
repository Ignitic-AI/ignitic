# ─── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=development
AI_ENGINE_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ignitic
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── RabbitMQ (amqp://user:password@host:port/vhost) ──────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Security ─────────────────────────────────────────────────────────────
# Must be identical across backend, ai-engine and mcp. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Base64 of 32 random bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
RATE_LIMIT_RPS=100

# ─── Worker settings ──────────────────────────────────────────────────────
BACKEND_MAX_WORKERS=10
BACKEND_TASK_TIMEOUT=300
BACKEND_COMPLIANCE_MODE=SOC2_GDPR
BACKEND_AUTOMATION_ENABLED=true

# ─── Email (Brevo) — optional, needed for verification / invite emails ────
SENDER_EMAIL=noreply@example.com
SENDER_NAME=Ignitic
BREVO_API_KEY=

# ─── File storage (Cloudinary) — optional ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── LLM (OpenRouter) — used for todo suggestions ─────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_TODO_SUGGEST_MODEL=

# ─── Google OAuth — optional ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/google-oauth/callback

# ─── Shopify OAuth — optional ─────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=
SHOPIFY_OAUTH_REDIRECT_URI=
SHOPIFY_OAUTH_STATE_SECRET=
SHOPIFY_OAUTH_FRONTEND_SUCCESS_URL=
SHOPIFY_OAUTH_FRONTEND_ERROR_URL=
