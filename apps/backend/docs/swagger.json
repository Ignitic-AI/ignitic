{
    "swagger": "2.0",
    "info": {
        "description": "API documentation for IgniticAI backend",
        "title": "IgniticAI API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "description": "Authenticates a user and returns a JWT token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "Login data",
                        "name": "loginData",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the authenticated user's profile",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Registers a new user and sends a verification email",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "User registration data",
                        "name": "userData",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/verify-email": {
            "post": {
                "description": "Verifies a user's email using a code",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Verify email",
                "parameters": [
                    {
                        "description": "Verification code",
                        "name": "verifyData",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/secrets/{app}/{name}": {
            "put": {
                "summary": "Create or update a secret",
                "description": "Creates or updates a secret for an app and organization",
                "tags": ["secrets"],
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "parameters": [
                    { "name": "app", "in": "path", "required": true, "type": "string", "description": "App name" },
                    { "name": "name", "in": "path", "required": true, "type": "string", "description": "Secret name" },
                    { "name": "body", "in": "body", "required": true, "schema": { "type": "object" }, "description": "Secret data" }
                ],
                "responses": {
                    "201": { "description": "Secret created successfully", "schema": { "type": "object" } },
                    "200": { "description": "Secret updated successfully", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "403": { "description": "Forbidden", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            },
            "get": {
                "summary": "Get a secret",
                "description": "Retrieves and decrypts a secret for an app and organization",
                "tags": ["secrets"],
                "produces": ["application/json"],
                "parameters": [
                    { "name": "app", "in": "path", "required": true, "type": "string", "description": "App name" },
                    { "name": "name", "in": "path", "required": true, "type": "string", "description": "Secret name" }
                ],
                "responses": {
                    "200": { "description": "Decrypted secret", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "403": { "description": "Forbidden", "schema": { "type": "object" } },
                    "404": { "description": "Secret not found", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            },
            "delete": {
                "summary": "Delete a secret",
                "description": "Deletes a secret for an app and organization",
                "tags": ["secrets"],
                "produces": ["application/json"],
                "parameters": [
                    { "name": "app", "in": "path", "required": true, "type": "string", "description": "App name" },
                    { "name": "name", "in": "path", "required": true, "type": "string", "description": "Secret name" }
                ],
                "responses": {
                    "200": { "description": "Secret deleted successfully", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "404": { "description": "Secret not found", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            }
        },
        "/api/v1/secrets/{app}": {
            "get": {
                "summary": "List secrets for an app",
                "description": "Lists all secrets for an app (without decryption)",
                "tags": ["secrets"],
                "produces": ["application/json"],
                "parameters": [
                    { "name": "app", "in": "path", "required": true, "type": "string", "description": "App name" }
                ],
                "responses": {
                    "200": { "description": "List of secrets", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            }
        },
        "/api/v1/secrets/user/all": {
            "get": {
                "summary": "List all secrets for a user",
                "description": "Lists all secrets for a user (personal + organization secrets they have access to)",
                "tags": ["secrets"],
                "produces": ["application/json"],
                "responses": {
                    "200": { "description": "List of secrets", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            }
        },
        "/api/v1/secrets/organization/{orgId}": {
            "get": {
                "summary": "List all secrets for an organization",
                "description": "Lists all secrets for an organization (only for admin/owner)",
                "tags": ["secrets"],
                "produces": ["application/json"],
                "parameters": [
                    { "name": "orgId", "in": "path", "required": true, "type": "string", "description": "Organization ID" }
                ],
                "responses": {
                    "200": { "description": "List of secrets", "schema": { "type": "object" } },
                    "400": { "description": "Invalid request", "schema": { "type": "object" } },
                    "401": { "description": "Unauthorized", "schema": { "type": "object" } },
                    "403": { "description": "Forbidden", "schema": { "type": "object" } },
                    "500": { "description": "Server error", "schema": { "type": "object" } }
                }
            }
        },
        "/api/v1/organizations": {
    "post": {
      "summary": "Create an organization",
      "description": "Creates a new organization and assigns the creator as an admin.",
      "tags": ["organizations"],
      "consumes": ["application/json"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        {
          "name": "organization",
          "in": "body",
          "description": "Organization data",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "employee_count": { "type": "integer", "minimum": 1 },
              "ecommerce_domain": { "type": "string" },
              "industry": { "type": "string" },
              "company_size": { "type": "string" },
              "website": { "type": "string" },
              "country": { "type": "string" },
              "city": { "type": "string" },
              "address": { "type": "string" },
              "phone_number": { "type": "string" },
              "subscription_plan": { "type": "string" }
            },
            "required": ["name", "employee_count"]
          }
        }
      ],
      "responses": {
        "201": { "description": "Created", "schema": { "type": "object" } },
        "400": { "description": "Bad Request", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "500": { "description": "Server Error", "schema": { "type": "object" } }
      }
    },
    "get": {
      "summary": "List organizations",
      "description": "Retrieves all active organizations the authenticated user belongs to.",
      "tags": ["organizations"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "200": {
          "description": "OK",
          "schema": {
            "type": "object",
            "properties": {
              "organizations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "employee_count": { "type": "integer" },
                    "ecommerce_domain": { "type": "string" },
                    "industry": { "type": "string" },
                    "company_size": { "type": "string" },
                    "website": { "type": "string" },
                    "country": { "type": "string" },
                    "city": { "type": "string" },
                    "subscription_plan": { "type": "string" },
                    "user_role": { "type": "string" },
                    "joined_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        },
        "400": { "description": "Invalid user ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}": {
    "get": {
      "summary": "Get an organization",
      "description": "Retrieves details of a specific organization if the user is a member.",
      "tags": ["organizations"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" }
      ],
      "responses": {
        "200": { "description": "OK", "schema": { "type": "object" } },
        "400": { "description": "Bad Request", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Forbidden", "schema": { "type": "object" } },
        "404": { "description": "Not Found", "schema": { "type": "object" } }
      }
    },
    "put": {
      "summary": "Update an organization",
      "description": "Updates the details of a specific organization (admin access required).",
      "tags": ["organizations"],
      "consumes": ["application/json"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" },
        {
          "name": "organization",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "employee_count": { "type": "integer" },
              "ecommerce_domain": { "type": "string" },
              "industry": { "type": "string" },
              "company_size": { "type": "string" },
              "website": { "type": "string" },
              "country": { "type": "string" },
              "city": { "type": "string" },
              "address": { "type": "string" },
              "phone_number": { "type": "string" },
              "subscription_plan": { "type": "string" }
            }
          }
        }
      ],
      "responses": {
        "200": { "description": "OK", "schema": { "type": "object" } },
        "400": { "description": "Bad Request", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Forbidden", "schema": { "type": "object" } },
        "404": { "description": "Not Found", "schema": { "type": "object" } },
        "500": { "description": "Server Error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}/join": {
    "post": {
      "summary": "Join an organization",
      "description": "Allows a user to join an organization by ID. If already a member but inactive, reactivates membership.",
      "tags": ["organizations"],
      "consumes": ["application/json"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" },
        {
          "name": "joinData",
          "in": "body",
          "required": false,
          "schema": { "type": "object", "properties": { "role": { "type": "string", "default": "member" } } }
        }
      ],
      "responses": {
        "200": { "description": "Successfully joined organization", "schema": { "type": "object" } },
        "400": { "description": "Invalid request or ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "404": { "description": "Organization not found", "schema": { "type": "object" } },
        "409": { "description": "User is already a member", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}/leave": {
    "post": {
      "summary": "Leave an organization",
      "description": "Allows a user to leave an organization they are currently a member of.",
      "tags": ["organizations"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" }
      ],
      "responses": {
        "200": { "description": "Successfully left organization", "schema": { "type": "object" } },
        "400": { "description": "Invalid request or ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "404": { "description": "User is not a member", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}/members": {
    "get": {
      "summary": "List members of an organization",
      "description": "Retrieves all active members of the specified organization. Requires the requester to be a current member.",
      "tags": ["members"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" }
      ],
      "responses": {
        "200": { "description": "List of members", "schema": { "type": "object" } },
        "400": { "description": "Invalid ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Not a member of organization", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    },
    "post": {
      "summary": "Add member to organization",
      "description": "Allows an admin to add a member to the organization by email. If membership existed but inactive, reactivates it.",
      "tags": ["members"],
      "consumes": ["application/json"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" },
        {
          "name": "memberData",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "role": { "type": "string", "enum": ["admin", "member", "viewer"], "default": "member" }
            }
          }
        }
      ],
      "responses": {
        "201": { "description": "Member successfully added", "schema": { "type": "object" } },
        "400": { "description": "Invalid request body or ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Only admins can add members", "schema": { "type": "object" } },
        "404": { "description": "User or organization not found", "schema": { "type": "object" } },
        "409": { "description": "User already active member", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}/members/{memberId}": {
    "delete": {
      "summary": "Remove member from organization",
      "description": "Allows an admin to remove a member from the organization. Uses soft deletion (deactivation). Prevents removing yourself if last admin.",
      "tags": ["members"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" },
        { "name": "memberId", "in": "path", "required": true, "type": "string", "description": "Member ID" }
      ],
      "responses": {
        "200": { "description": "Member successfully removed", "schema": { "type": "object" } },
        "400": { "description": "Invalid ID format or attempt to remove last admin", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Only admins can remove members", "schema": { "type": "object" } },
        "404": { "description": "Member not found", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    },
    "put": {
      "summary": "Update member role",
      "description": "Allows an admin to update a member's role within the organization. Prevents self-demotion if last admin.",
      "tags": ["members"],
      "consumes": ["application/json"],
      "produces": ["application/json"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "type": "string", "description": "Organization ID" },
        { "name": "memberId", "in": "path", "required": true, "type": "string", "description": "Member ID" },
        {
          "name": "roleData",
          "in": "body",
          "required": true,
          "schema": { "type": "object", "properties": { "role": { "type": "string", "enum": ["admin", "member", "viewer"] } } }
        }
      ],
      "responses": {
        "200": { "description": "Member role updated", "schema": { "type": "object" } },
        "400": { "description": "Invalid request body or ID format", "schema": { "type": "object" } },
        "401": { "description": "Unauthorized", "schema": { "type": "object" } },
        "403": { "description": "Only admins can update member roles", "schema": { "type": "object" } },
        "404": { "description": "Member not found", "schema": { "type": "object" } },
        "500": { "description": "Server error", "schema": { "type": "object" } }
      }
    }
  },
  "/api/v1/organizations/{id}/business-profile": {
  "post": {
    "summary": "Create or update organization business profile",
    "description": "Creates a new organization business profile if it doesn’t exist, otherwise updates the existing profile. Only organization admins can perform this action.",
    "tags": ["organization-business-profile"],
    "consumes": ["application/json"],
    "produces": ["application/json"],
    "security": [{ "BearerAuth": [] }],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "type": "string",
        "description": "Organization ID"
      },
      {
        "name": "profile",
        "in": "body",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "business_hours": { "type": "string" },
            "primary_markets": { "type": "array", "items": { "type": "string" } },
            "default_currency": { "type": "string" },
            "supported_languages": { "type": "array", "items": { "type": "string" } },
            "support_email": { "type": "string" },
            "support_channels": { "type": "array", "items": { "type": "string" } },
            "social_links": { "type": "object", "additionalProperties": { "type": "string" } },
            "fulfillment_method": { "type": "string" },
            "shipping_carriers": { "type": "array", "items": { "type": "string" } },
            "returns_policy_url": { "type": "string" },
            "payment_gateways": { "type": "array", "items": { "type": "string" } },
            "tax_identifiers": { "type": "object", "additionalProperties": { "type": "string" } },
            "primary_contacts": { "type": "array", "items": { "type": "object" } },
            "compliance_contacts": { "type": "array", "items": { "type": "object" } },
            "ecommerce_platforms": { "type": "array", "items": { "type": "object" } },
            "key_systems": { "type": "array", "items": { "type": "string" } },
            "holiday_blackout_dates": { "type": "array", "items": { "type": "string" } },
            "data_processing_addenda": { "type": "string" }
          }
        }
      }
    ],
    "responses": {
      "200": { "description": "Business profile created or updated successfully", "schema": { "type": "object" } },
      "400": { "description": "Invalid request or ID format", "schema": { "type": "object" } },
      "401": { "description": "Unauthorized", "schema": { "type": "object" } },
      "403": { "description": "Forbidden – Only admin can modify business profile", "schema": { "type": "object" } },
      "500": { "description": "Server error", "schema": { "type": "object" } }
    }
  },
  "get": {
    "summary": "Get organization business profile",
    "description": "Retrieves the business profile of an organization. Only organization admins can view it.",
