# Normalize line endings to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs and exclude from language stats
package-lock.json linguist-generated=true -diff
uv.lock linguist-generated=true -diff
go.sum linguist-generated=true -diff
apps/backend/docs/docs.go linguist-generated=true
apps/backend/docs/swagger.* linguist-generated=true
